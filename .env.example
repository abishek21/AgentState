# Copy to .env and adjust as needed.

# Shared backend connection string. Use this on every machine (laptop,
# remote GPU box, CI) that should see the same AgentState project.
#
# Local single-machine dev mode (default if unset):
# AGENTSTATE_DATABASE_URL=sqlite:///.agentstate/state.db
#
# Shared PostgreSQL mode (required for laptop <-> remote GPU workflows):
AGENTSTATE_DATABASE_URL=postgresql://agentstate:changeme@localhost:5432/agentstate

# Set by `agentstate init` into .agentstate/config.json; override here only
# to force-join a specific project without relying on git remote detection.
# AGENTSTATE_PROJECT_ID=

# Label identifying which agent/client is recording state, e.g. "copilot",
# "claude-code". Set this per MCP client config, not globally.
AGENTSTATE_AGENT=unknown-agent

# Optional: pin a session id (otherwise a random one is generated per process).
# AGENTSTATE_SESSION_ID=
